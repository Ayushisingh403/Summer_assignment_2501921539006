#Matrix Digonal Sum
class Solution {
    public int diagonalSum(int[][] mat) {
        int n = mat.length;
        int sum = 0;

        for (int i = 0; i < n; i++) {
            sum += mat[i][i];           // Primary diagonal
            sum += mat[i][n - 1 - i];  // Secondary diagonal
        }

        // Remove middle element if counted twice
        if (n % 2 == 1) {
            sum -= mat[n / 2][n / 2];
        }

        return sum;
    }
}

#Reshape the matrix
class Solution {
    public int[][] matrixReshape(int[][] mat, int r, int c) {
        int m = mat.length, n = mat[0].length;

        if (m * n != r * c) return mat;

        int[][] res = new int[r][c];

        for (int i = 0; i < m * n; i++) {
            res[i / c][i % c] = mat[i / n][i % n];
        }

        return res;
    }
}

#Spiral Matrix

import java.util.*;

class Solution {
    public List<Integer> spiralOrder(int[][] m) {
        List<Integer> a = new ArrayList<>();
        int t = 0, b = m.length - 1, l = 0, r = m[0].length - 1;

        while (t <= b && l <= r) {
            for (int i = l; i <= r; i++) a.add(m[t][i]); t++;
            for (int i = t; i <= b; i++) a.add(m[i][r]); r--;
            if (t <= b) for (int i = r; i >= l; i--) a.add(m[b][i]); b--;
            if (l <= r) for (int i = b; i >= t; i--) a.add(m[i][l]); l++;
        }
        return a;
    }
}








